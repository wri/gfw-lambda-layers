# Python stdlib-ish / packaging noise
*-info/*
*/tests/*
python/pip/*
python/pkg_resources/*
python/setuptools/*
python/wheel/*
python/easy_install/*

# Rasterio runtime bloat
python/rasterio/tests/*
python/rasterio/gdal_data/*
python/rasterio/*.pyx
python/rasterio/*.pxi

# NumPy (runtime .so files are needed, but tests/docs are not)
python/numpy/core/tests/*
python/numpy/testing/*
python/numpy/tests/*
python/numpy.libs/*

# Compile-time only artifacts
lib/pkgconfig/*
lib/*.a
include/*

# Documentation / metadata
share/doc/*
share/man/*
share/gtk-doc/*
share/bash-completion/*
share/aclocal/*
share/cryptopp/*

# PROJ: test grids not needed at runtime
share/proj/tests/*